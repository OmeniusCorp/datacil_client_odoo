<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="datacil_client_odoo.datacil_dashboard">
        <div class="h-100 overflow-auto">
            <div class="container-fluid py-3 o_datacil_dashboard">
                <!-- Header -->
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
                    <h2 class="mb-0">Datacil Dashboard</h2>
                    <button class="btn btn-primary" t-on-click="onRefresh" t-att-disabled="state.loading">
                        <i class="fa fa-refresh me-1" t-att-class="{'fa-spin': state.loading}"/>
                        Refresh
                    </button>
                </div>

                <!-- Loading -->
                <t t-if="state.loading">
                    <div class="text-center py-5">
                        <i class="fa fa-spinner fa-spin fa-3x text-primary"/>
                        <p class="mt-3 text-muted">Loading data...</p>
                    </div>
                </t>

                <!-- Error -->
                <t t-elif="state.error">
                    <div t-attf-class="alert d-flex align-items-center gap-2 {{state.errorCode === 'not_configured' ? 'alert-warning' : 'alert-danger'}}" role="alert">
                        <i t-attf-class="fa fa-lg {{state.errorCode === 'not_configured' ? 'fa-plug' : 'fa-exclamation-triangle'}}"/>
                        <span class="flex-grow-1" t-esc="state.error"/>
                        <button t-if="isSystem and (state.errorCode === 'not_configured' or state.errorCode === 'unauthorized')"
                                class="btn btn-sm btn-primary" t-on-click="openSettings">
                            <i class="fa fa-cog me-1"/>Open settings
                        </button>
                        <button t-else="" class="btn btn-sm btn-primary" t-on-click="onRefresh">
                            <i class="fa fa-refresh me-1"/>Retry
                        </button>
                    </div>
                </t>

                <!-- Dashboard Content -->
                <t t-else="">
                    <!-- KPI Cards -->
                    <div class="row mb-4">
                        <div class="col-12 col-sm-4 mb-3">
                            <div class="card border-primary h-100">
                                <div class="card-body text-center">
                                    <div class="text-muted mb-1">Credit Balance</div>
                                    <h1 class="text-primary mb-0" t-esc="state.credits?.balance || 0"/>
                                    <small class="text-muted" t-esc="state.credits?.currency || 'credits'"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-sm-4 mb-3">
                            <div class="card border-warning h-100">
                                <div class="card-body text-center">
                                    <div class="text-muted mb-1">Total Consumed</div>
                                    <h1 class="text-warning mb-0" t-esc="totalSpent"/>
                                    <small class="text-muted">credits used</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-sm-4 mb-3">
                            <div class="card border-info h-100">
                                <div class="card-body text-center">
                                    <div class="text-muted mb-1">Queries Performed</div>
                                    <h1 class="text-info mb-0" t-esc="state.history.length"/>
                                    <small class="text-muted">transactions</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <!-- Costs Table -->
                        <div class="col-12 col-lg-5 mb-4">
                            <div class="card h-100">
                                <div class="card-header bg-white">
                                    <h5 class="mb-0"><i class="fa fa-tags me-2"/>Costs by Service</h5>
                                </div>
                                <div class="card-body p-0 table-responsive">
                                    <table class="table table-hover mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Service</th>
                                                <th>Description</th>
                                                <th class="text-end">Cost</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="state.costs" t-as="cost" t-key="cost_index">
                                                <tr>
                                                    <td>
                                                        <span class="badge bg-secondary text-wrap text-start" t-esc="cost.serviceKey"/>
                                                    </td>
                                                    <td class="text-muted small" t-esc="cost.description"/>
                                                    <td class="text-end">
                                                        <span t-if="cost.cost === 0" class="badge bg-success">Free</span>
                                                        <span t-else="" class="fw-bold" t-esc="cost.cost + ' cr'"/>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <!-- Usage Breakdown -->
                        <div class="col-12 col-lg-7 mb-4">
                            <div class="card mb-4">
                                <div class="card-header bg-white">
                                    <h5 class="mb-0"><i class="fa fa-pie-chart me-2"/>Consumption by Service</h5>
                                </div>
                                <div class="card-body p-0 table-responsive">
                                    <table class="table table-hover mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Service</th>
                                                <th class="text-end">Queries</th>
                                                <th class="text-end">Credits</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="serviceBreakdown" t-as="item" t-key="item.service">
                                                <tr>
                                                    <td>
                                                        <span class="badge bg-primary text-wrap text-start" t-esc="item.service"/>
                                                    </td>
                                                    <td class="text-end" t-esc="item.count"/>
                                                    <td class="text-end fw-bold" t-esc="item.total"/>
                                                </tr>
                                            </t>
                                            <t t-if="serviceBreakdown.length === 0">
                                                <tr><td colspan="3" class="text-center text-muted py-3">No data</td></tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- Transaction History -->
                            <div class="card">
                                <div class="card-header bg-white">
                                    <h5 class="mb-0"><i class="fa fa-history me-2"/>Transaction History</h5>
                                </div>
                                <div class="card-body p-0 table-responsive" style="max-height: 400px;">
                                    <table class="table table-hover mb-0">
                                        <thead class="table-light" style="position: sticky; top: 0;">
                                            <tr>
                                                <th>Date</th>
                                                <th>Service</th>
                                                <th>Query</th>
                                                <th class="text-end">Credits</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="state.history" t-as="tx" t-key="tx_index">
                                                <tr>
                                                    <td class="text-muted small text-nowrap" t-esc="tx.date"/>
                                                    <td>
                                                        <span class="badge bg-primary text-wrap text-start" t-esc="tx.service_key"/>
                                                    </td>
                                                    <td>
                                                        <code class="text-break" t-esc="tx.query_param"/>
                                                    </td>
                                                    <td class="text-end text-danger fw-bold" t-esc="tx.amount"/>
                                                </tr>
                                            </t>
                                            <t t-if="state.history.length === 0">
                                                <tr><td colspan="4" class="text-center text-muted py-3">No transactions</td></tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </div>
        </div>
    </t>
</templates>
