<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_employee_form_datacil" model="ir.ui.view">
        <field name="name">hr.employee.form.datacil</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <!-- Query straight from the Personal tab, next to the identification number. -->
            <xpath expr="//group[@name='citizenship']/field[@name='identification_id']" position="replace">
                <label for="identification_id"/>
                <div class="o_row">
                    <field name="identification_id" nolabel="1"/>
                    <widget name="datacil_lookup" field="identification_id" method="datacil_check_identity" apply="0" require_saved="1"
                            string="Datacil" icon="fa-id-card" variant="link"/>
                </div>
            </xpath>

            <xpath expr="//page[@name='personal_information']" position="after">
                <page name="datacil" string="Datacil" groups="hr.group_hr_user">
                    <div class="alert alert-info mb-3" role="alert" invisible="identification_id">
                        Enter the employee's identification number (Personal tab) to enable the Datacil queries.
                    </div>
                    <div class="alert alert-info mb-3" role="alert" invisible="id or not identification_id">
                        Save the employee to enable the Datacil queries.
                    </div>
                    <div class="d-flex flex-wrap gap-2 mb-3" name="datacil_buttons">
                        <widget name="datacil_lookup" field="identification_id" method="datacil_check_identity" apply="0" require_saved="1"
                                string="Verify identity &amp; fill personal data" icon="fa-id-card"/>
                        <widget name="datacil_lookup" field="identification_id" method="datacil_check_licence" apply="0" require_saved="1"
                                string="Driver licence" icon="fa-car" variant="secondary"/>
                        <widget name="datacil_lookup" field="identification_id" method="datacil_check_judicial" apply="0" require_saved="1"
                                string="Judicial records" icon="fa-gavel" variant="secondary"/>
                        <widget name="datacil_lookup" field="identification_id" method="datacil_check_ant" apply="0" require_saved="1"
                                string="ANT citations &amp; debt" icon="fa-exclamation-circle" variant="secondary"/>
                    </div>
                    <group>
                        <group string="Summary">
                            <field name="datacil_last_sync"/>
                            <field name="datacil_has_licence"/>
                            <field name="datacil_licence_type" invisible="not datacil_has_licence"/>
                            <field name="datacil_licence_valid_from" invisible="not datacil_has_licence"/>
                            <field name="datacil_licence_valid_until" invisible="not datacil_has_licence" decoration-danger="datacil_licence_expired"/>
                            <field name="datacil_licence_expired" invisible="1"/>
                            <label for="datacil_licence_points" invisible="not datacil_has_licence"/>
                            <div class="o_row" invisible="not datacil_has_licence">
                                <field name="datacil_licence_points"/> /
                                <field name="datacil_licence_points_max"/>
                            </div>
                        </group>
                        <group string="Records">
                            <field name="datacil_judicial_count"/>
                            <field name="datacil_ant_citations"/>
                        </group>
                    </group>
                    <div class="alert alert-warning mb-3" role="alert" invisible="not datacil_licence_expired">
                        The driver licence on file has expired.
                    </div>
                    <field name="datacil_sections" invisible="1"/>
                    <field name="datacil_info" readonly="1" nolabel="1"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
